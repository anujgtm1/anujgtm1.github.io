---
import { getCollection, getEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import { ABOUT, SOCIALS } from "@consts"
import { pickPortraitPhoto } from "@lib/photos"
import { formatDate, formatShortDate } from "@lib/utils"
import type { PhotoItem } from "@types"

const [rawWork, nowEntry, rawPhotos] = await Promise.all([
  getCollection("work"),
  getEntry("now", "current"),
  getCollection("photos"),
])

const sortedWork = [...rawWork].sort(
  (a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime(),
)

const workEntries = await Promise.all(
  sortedWork.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  }),
)

const photos: readonly PhotoItem[] = rawPhotos
  .filter((photo) => !photo.data.draft)
  .map((photo) => ({
    slug: photo.slug,
    title: photo.data.title,
    image: photo.data.image,
    alt: photo.data.alt,
    date: formatShortDate(photo.data.date),
    dateMs: photo.data.date.getTime(),
    location: photo.data.location,
    camera: photo.data.camera,
    caption: photo.data.caption,
    category: photo.data.category,
    featured: photo.data.featured,
    linkedHref: photo.data.linkedHref,
    linkedLabel: photo.data.linkedLabel,
    draft: photo.data.draft,
  }))

const portraitPhoto = pickPortraitPhoto(photos)

function formatWorkDate(input: Date | string): string {
  if (typeof input === "string") return input
  const month = input.toLocaleDateString("en-US", { month: "short" })
  const year = input.getFullYear()
  return `${month} ${year}`
}

const currentLedger = nowEntry
  ? [
      { label: "Location", value: nowEntry.data.location },
      { label: "Currently Building", value: nowEntry.data.currentlyBuilding },
      { label: "Currently Reading", value: nowEntry.data.currentlyReading },
      { label: "Next Trip", value: nowEntry.data.nextTrip },
      { label: "On My Mind", value: nowEntry.data.listeningOrThinking },
    ].filter(
      (item): item is { readonly label: string; readonly value: string } =>
        typeof item.value === "string" && item.value.trim().length > 0,
    )
  : []
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <!-- Top Intro Spread (7/5) -->
  <section class="border-b border-border py-12 sm:py-16">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-7 space-y-6">
          <p class="editorial-kicker">ABOUT · ANUJ GAUTAM</p>
          <h1 class="editorial-display text-ink">
            Engineer, researcher, reader, and occasional bookbinder.
          </h1>

          <div class="space-y-4 text-base sm:text-lg text-ink-muted leading-relaxed max-w-2xl">
            <p>
              I'm <strong class="font-semibold text-ink">Anuj Gautam</strong>. By day I work as a software engineer on data center infrastructure deployment at <strong class="font-semibold text-ink">Google</strong>. Before that, I completed my PhD in computer science at the <strong class="font-semibold text-ink">University of Tennessee</strong> in Knoxville, focusing on usable security and secure authentication systems.
            </p>
            <p>
              Outside of work, I like building small, opinionated tools I genuinely use — from browser-based bookbinding templates and map-first trip planners to quiet personal software. When I step away from the keyboard, I'm usually reading with a pencil in hand, sewing paper signatures at the bench, or wandering new cities with a camera and a folded map.
            </p>
            <p>
              This site is a calm notebook for all of those threads: short essays, book marginalia, photographs, travel coordinates, and engineering dossiers.
            </p>
          </div>
        </div>

        <figure class="lg:col-span-5 space-y-2.5 max-w-md lg:max-w-none">
          <div class="overflow-hidden rounded-none border border-border bg-surface">
            {
              portraitPhoto ? (
                <img
                  src={portraitPhoto.image}
                  alt={portraitPhoto.alt}
                  fetchpriority="high"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover"
                />
              ) : (
                <svg
                  viewBox="0 0 480 600"
                  class="block aspect-[4/5] w-full select-none"
                  role="img"
                  aria-label="Archival AG monogram specimen plate for Anuj Gautam"
                >
                  <defs>
                    <pattern id="about-monogram-grid" width="24" height="24" patternUnits="userSpaceOnUse">
                      <path
                        d="M 24 0 L 0 0 0 24"
                        fill="none"
                        stroke="var(--border)"
                        stroke-width="0.6"
                        opacity="0.7"
                      />
                    </pattern>
                  </defs>

                  <rect width="480" height="600" fill="var(--surface)" />
                  <rect width="480" height="600" fill="url(#about-monogram-grid)" />

                  {/* Architectural double border */}
                  <rect
                    x="28"
                    y="28"
                    width="424"
                    height="544"
                    fill="var(--surface-elevated)"
                    fill-opacity="0.55"
                    stroke="var(--border)"
                    stroke-width="1"
                  />
                  <rect
                    x="42"
                    y="42"
                    width="396"
                    height="516"
                    fill="none"
                    stroke="var(--border)"
                    stroke-width="0.8"
                  />

                  {/* Corner registration marks */}
                  <g stroke="var(--accent)" stroke-width="1.3" fill="none" opacity="0.8">
                    <path d="M 54 70 L 54 54 L 70 54" />
                    <path d="M 410 54 L 426 54 L 426 70" />
                    <path d="M 54 530 L 54 546 L 70 546" />
                    <path d="M 410 546 L 426 546 L 426 530" />
                  </g>

                  {/* Top specimen header */}
                  <text
                    x="240"
                    y="92"
                    text-anchor="middle"
                    fill="var(--ink-muted)"
                    font-family="JetBrains Mono, monospace"
                    font-size="10"
                    letter-spacing="2.2"
                  >
                    ARCHIVAL SPECIMEN · VOL. 2026
                  </text>
                  <line x1="96" y1="112" x2="384" y2="112" stroke="var(--border)" stroke-width="0.9" />

                  {/* Concentric geometric medallion */}
                  <g transform="translate(240, 294)">
                    <circle
                      cx="0"
                      cy="0"
                      r="128"
                      fill="var(--surface)"
                      stroke="var(--border)"
                      stroke-width="1"
                    />
                    <circle
                      cx="0"
                      cy="0"
                      r="112"
                      fill="none"
                      stroke="var(--accent)"
                      stroke-width="1.1"
                      stroke-dasharray="4 4"
                      opacity="0.85"
                    />
                    <line x1="-148" y1="0" x2="-128" y2="0" stroke="var(--ink-muted)" stroke-width="0.9" />
                    <line x1="128" y1="0" x2="148" y2="0" stroke="var(--ink-muted)" stroke-width="0.9" />
                    <line x1="0" y1="-148" x2="0" y2="-128" stroke="var(--ink-muted)" stroke-width="0.9" />
                    <line x1="0" y1="128" x2="0" y2="148" stroke="var(--ink-muted)" stroke-width="0.9" />

                    <text
                      x="0"
                      y="26"
                      text-anchor="middle"
                      fill="var(--ink)"
                      font-family="Newsreader, Georgia, serif"
                      font-size="88"
                      font-weight="500"
                      letter-spacing="4"
                    >
                      AG
                    </text>
                  </g>

                  {/* Bottom specimen colophon */}
                  <line x1="96" y1="472" x2="384" y2="472" stroke="var(--border)" stroke-width="0.9" />
                  <text
                    x="240"
                    y="502"
                    text-anchor="middle"
                    fill="var(--ink)"
                    font-family="Newsreader, Georgia, serif"
                    font-size="18"
                    font-weight="500"
                  >
                    Anuj Gautam
                  </text>
                  <text
                    x="240"
                    y="526"
                    text-anchor="middle"
                    fill="var(--atlas)"
                    font-family="JetBrains Mono, monospace"
                    font-size="9.5"
                    letter-spacing="1.8"
                  >
                    SOFTWARE · RESEARCH · MARGINALIA
                  </text>
                </svg>
              )
            }
          </div>
          <figcaption class="flex flex-wrap items-baseline justify-between gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-muted">
            <span>
              {portraitPhoto ? `FIG. 01 · ${portraitPhoto.title}` : "FIG. 01 · MONOGRAM SPECIMEN"}
            </span>
            <span>{portraitPhoto?.location ?? "UNITED STATES"}</span>
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <!-- Experience & Background -->
  <section class="border-b border-border py-12 sm:py-14" aria-labelledby="experience-heading">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-4 space-y-2">
          <p class="editorial-kicker">Experience &amp; Background</p>
          <h2 id="experience-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
            Engineering &amp; Research Chapters
          </h2>
          <p class="text-sm text-ink-muted leading-relaxed">
            Infrastructure engineering, privacy assurance, and usable security research across industry and academia.
          </p>
        </div>

        <ol class="lg:col-span-8 border-t border-border divide-y divide-border">
          {
            workEntries.map((entry) => (
              <li class="py-6 first:pt-5 last:pb-0 grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-6">
                <div class="sm:col-span-4 space-y-1 font-mono text-xs uppercase tracking-[0.1em] text-ink-muted pt-1">
                  <p>
                    {formatWorkDate(entry.data.dateStart)} — {formatWorkDate(entry.data.dateEnd)}
                  </p>
                  {entry.data.location && <p>{entry.data.location}</p>}
                </div>

                <div class="sm:col-span-8 space-y-1.5">
                  <h3 class="font-serif text-xl sm:text-2xl font-medium text-ink">
                    {entry.data.company}
                  </h3>
                  <p class="font-mono text-xs uppercase tracking-[0.12em] text-atlas font-medium">
                    {entry.data.role}
                  </p>
                  <div class="prose dark:prose-invert prose-sm max-w-none pt-1 text-ink-muted [&>p]:my-0">
                    <entry.Content />
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <!-- Currently (Lightweight Inline Ledger) -->
  {
    currentLedger.length > 0 && (
      <section class="border-b border-border bg-surface/35 py-12 sm:py-14" aria-labelledby="currently-heading">
        <Container size="lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
            <div class="lg:col-span-4 space-y-2">
              <p class="editorial-kicker text-accent">Currently</p>
              <h2 id="currently-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
                On the Desk
              </h2>
              {nowEntry && (
                <p class="font-mono text-xs uppercase tracking-[0.12em] text-ink-muted">
                  Updated {formatDate(nowEntry.data.updatedAt)}
                </p>
              )}
            </div>

            <dl class="lg:col-span-8 border-t border-border divide-y divide-border">
              {currentLedger.map((item) => (
                <div class="py-4 grid grid-cols-1 sm:grid-cols-12 gap-1.5 sm:gap-6 items-baseline">
                  <dt class="sm:col-span-4 font-mono text-xs uppercase tracking-[0.12em] text-ink-muted">
                    {item.label}
                  </dt>
                  <dd class="sm:col-span-8 font-serif text-lg text-ink leading-snug">
                    {item.value}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </Container>
      </section>
    )
  }

  <!-- Elsewhere / Contact -->
  <section class="py-12 sm:py-14" aria-labelledby="contact-heading">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-baseline">
        <div class="lg:col-span-4 space-y-2">
          <p class="editorial-kicker">Elsewhere &amp; Contact</p>
          <h2 id="contact-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
            Correspondence
          </h2>
        </div>

        <div class="lg:col-span-8 space-y-5">
          <p class="text-base text-ink-muted leading-relaxed max-w-xl">
            Always glad to hear from people interested in systems engineering, security research, bookbinding, or trading travel and reading notes.
          </p>

          <div class="flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-border pt-5 text-sm">
            {
              SOCIALS.map((social) => (
                <a
                  href={social.HREF}
                  target={social.HREF.startsWith("mailto:") ? undefined : "_blank"}
                  rel={social.HREF.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                  class="group inline-flex items-center gap-2 font-medium text-ink hover:text-accent transition-colors"
                >
                  <svg class="size-4 fill-current text-ink-muted group-hover:text-accent transition-colors" aria-hidden="true">
                    <use href={`/social.svg#${social.ICON}`}></use>
                  </svg>
                  <span class="underline decoration-border underline-offset-[6px] group-hover:decoration-accent transition-colors">
                    {social.NAME}
                  </span>
                </a>
              ))
            }
            <a
              href="/rss.xml"
              class="group inline-flex items-center gap-2 font-medium text-ink hover:text-accent transition-colors"
            >
              <svg class="size-4 stroke-current text-ink-muted group-hover:text-accent transition-colors" aria-hidden="true">
                <use href="/ui.svg#rss"></use>
              </svg>
              <span class="underline decoration-border underline-offset-[6px] group-hover:decoration-accent transition-colors">
                RSS Feed
              </span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
