---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ProjectVisualPlate from "@components/ProjectVisualPlate.astro"
import { PROJECTS } from "@consts"
import { formatShortDate } from "@lib/utils"

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <TopLayout>
    <div class="space-y-3 pb-2">
      <p class="editorial-kicker">Engineering Dossiers · {projects.length} Builds</p>
      <h1 class="editorial-title text-ink">{PROJECTS.TITLE}</h1>
      <p class="max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
        {PROJECTS.DESCRIPTION}
      </p>
    </div>
  </TopLayout>

  <BottomLayout>
    <ol class="pb-10">
      {
        projects.map((project, idx) => {
          const isReversed = idx % 2 === 1
          return (
            <li class="border-t border-border pt-10 pb-12 last:pb-2">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                <a
                  href={`/projects/${project.slug}/`}
                  aria-label={`Open ${project.data.title} engineering dossier`}
                  class={`group block lg:col-span-7 focus-visible:rounded-none ${
                    isReversed ? "lg:order-2" : "lg:order-1"
                  }`}
                >
                  <ProjectVisualPlate slug={project.slug} title={project.data.title} />
                </a>

                <div
                  class={`lg:col-span-5 space-y-4 ${
                    isReversed ? "lg:order-1" : "lg:order-2"
                  }`}
                >
                  <div class="flex flex-wrap items-baseline gap-3 text-xs font-mono uppercase tracking-wider text-ink-muted">
                    <span class="font-serif text-3xl sm:text-4xl font-normal text-ink-muted/60 tabular-nums leading-none">
                      {String(idx + 1).padStart(2, "0")}
                    </span>
                    <span aria-hidden="true" class="h-px w-6 bg-border self-center" />
                    <span class="text-atlas font-medium">{project.data.status}</span>
                    {project.data.role && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{project.data.role}</span>
                      </>
                    )}
                    <span aria-hidden="true">·</span>
                    <time datetime={project.data.date.toISOString()}>
                      {formatShortDate(project.data.date)}
                    </time>
                  </div>

                  <h2 class="font-serif text-3xl sm:text-[2.15rem] font-medium text-ink leading-tight">
                    <a
                      href={`/projects/${project.slug}/`}
                      class="hover:text-accent transition-colors"
                    >
                      {project.data.title}
                    </a>
                  </h2>

                  <p class="text-base text-ink-muted leading-relaxed">
                    {project.data.summary}
                  </p>

                  <p class="font-mono text-xs tracking-wide text-ink-muted pt-1">
                    {project.data.tags.join(" · ")}
                  </p>

                  <div class="flex flex-wrap items-center gap-6 pt-2">
                    <a
                      href={`/projects/${project.slug}/`}
                      class="text-sm font-medium text-ink underline decoration-border underline-offset-[6px] hover:text-accent hover:decoration-accent transition-colors"
                    >
                      Read dossier →
                    </a>
                    {project.data.demoUrl && (
                      <a
                        href={project.data.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-xs uppercase tracking-wider text-atlas hover:text-accent transition-colors"
                      >
                        Live app ↗
                      </a>
                    )}
                    {project.data.repoUrl && (
                      <a
                        href={project.data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-xs uppercase tracking-wider text-ink-muted hover:text-accent transition-colors"
                      >
                        GitHub ↗
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          )
        })
      }
    </ol>
  </BottomLayout>
</PageLayout>
