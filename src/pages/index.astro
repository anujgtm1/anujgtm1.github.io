---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import { SITE } from "@consts"
import { SPINE_PALETTES, deriveYearRead, sortBooks } from "@lib/bookshelf"
import { VISITED_COUNTRY_IDS } from "@data/visitedCountries"
import { WORLD_COUNTRIES, WORLD_NE_VIEWBOX } from "@data/worldCountries"
import { formatCoordinates } from "@lib/atlas"
import { buildRecentJournalEntries } from "@lib/journal"
import { computeParkSurveySummary } from "@lib/parks"
import { pickFeaturedPhoto } from "@lib/photos"
import { formatShortDate } from "@lib/utils"
import { buildNaturalEarthGraticule, projectNaturalEarth } from "@lib/worldProjection"
import type { PhotoItem, RecentJournalKind } from "@types"

const [rawPosts, rawProjects, rawBooks, rawTrips, rawPhotos] = await Promise.all([
  getCollection("blog"),
  getCollection("projects"),
  getCollection("books"),
  getCollection("travel"),
  getCollection("photos"),
])

const posts = rawPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const projects = rawProjects
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const books = sortBooks(
  rawBooks
    .filter((book) => !book.data.draft)
    .map((book) => ({
      slug: book.slug,
      title: book.data.title,
      author: book.data.author,
      status: book.data.status,
      rating: book.data.rating,
      dateRead: book.data.dateRead ? formatShortDate(book.data.dateRead) : undefined,
      yearRead: deriveYearRead(book.data.dateRead, book.data.yearRead),
      pages: book.data.pages,
      isbn: book.data.isbn,
      coverUrl: book.data.coverUrl,
      tags: book.data.tags,
      spineTheme: book.data.spineTheme,
      quote: book.data.quote,
      summary: book.data.summary,
      notesHtml: "",
    })),
)

const shelfSpines = books.slice(0, 6)

const trips = rawTrips
  .filter((trip) => !trip.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const photos: readonly PhotoItem[] = rawPhotos
  .filter((photo) => !photo.data.draft)
  .map((photo) => ({
    slug: photo.slug,
    title: photo.data.title,
    imageUrl: photo.data.imageUrl,
    thumbnailUrl: photo.data.thumbnailUrl,
    alt: photo.data.alt,
    caption: photo.data.caption,
    date: formatShortDate(photo.data.date),
    dateIso: photo.data.date.toISOString(),
    dateMs: photo.data.date.getTime(),
    location: photo.data.location,
    album: photo.data.album,
    category: photo.data.category,
    camera: photo.data.camera,
    aspectRatio: photo.data.aspectRatio,
    featured: photo.data.featured,
    tags: photo.data.tags,
    linkedHref: photo.data.linkedHref,
    linkedLabel: photo.data.linkedLabel,
    draft: photo.data.draft,
  }))

const featuredPhoto = pickFeaturedPhoto(photos)

const recentEntries = buildRecentJournalEntries(
  {
    blog: posts.map((post) => ({
      slug: post.slug,
      title: post.data.title,
      date: post.data.date,
      heroImage: post.data.heroImage,
      heroImageAlt: post.data.heroImageAlt,
      draft: post.data.draft,
    })),
    projects: projects.map((project) => ({
      slug: project.slug,
      title: project.data.title,
      date: project.data.date,
      draft: project.data.draft,
    })),
    travel: trips.map((trip) => ({
      slug: trip.slug,
      title: trip.data.title,
      date: trip.data.date,
      coverImage: trip.data.coverImage,
      coverImageAlt: trip.data.coverImageAlt,
      draft: trip.data.draft,
    })),
    books: rawBooks
      .filter((book) => !book.data.draft)
      .map((book) => ({
        slug: book.slug,
        title: book.data.title,
        status: book.data.status,
        dateRead: book.data.dateRead,
        yearRead: book.data.yearRead,
        coverUrl: book.data.coverUrl,
        draft: book.data.draft,
      })),
  },
  4,
)

const JOURNAL_KIND_LABEL: Readonly<Record<RecentJournalKind, string>> = {
  blog: "BLOG",
  project: "PROJECT",
  travel: "TRAVEL",
  book: "BOOK",
}

const JOURNAL_KIND_COLOR: Readonly<Record<RecentJournalKind, string>> = {
  blog: "text-accent",
  project: "text-atlas",
  travel: "text-atlas",
  book: "text-accent",
}

const worldGraticule = buildNaturalEarthGraticule()
const visitedCountrySet = new Set<string>(VISITED_COUNTRY_IDS)
const parkSummary = computeParkSurveySummary()

const mapPins = trips.slice(0, 6).map((trip) => ({
  label: trip.data.city,
  country: trip.data.country,
  code: trip.data.stampCode,
  coordinatesLabel: formatCoordinates({ lat: trip.data.lat, lng: trip.data.lng }),
  point: projectNaturalEarth({ lat: trip.data.lat, lng: trip.data.lng }),
  href: `/travel/${trip.slug}/`,
}))
---

<PageLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <!-- Section 1: Split Swiss Hero -->
  <section>
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Left Column (6/12): Title + Bio + Recent -->
        <div class="lg:col-span-6 py-10 lg:py-12 lg:pr-10 flex flex-col justify-between gap-10">
          <div class="space-y-5">
            <h1 class="editorial-display text-ink">
              A quiet archive of software, books, and journeys.
            </h1>
            <p class="text-base text-ink-muted leading-relaxed max-w-xl">
              <strong class="font-semibold text-ink">Anuj Gautam</strong> — software engineer on Google's data center infrastructure deployment team, PhD in usable security (UTK), avid reader, and builder of small offline tools.
            </p>
          </div>

          <section aria-labelledby="swiss-recent-heading">
            <h2
              id="swiss-recent-heading"
              class="editorial-kicker pb-2.5"
            >
              Recent
            </h2>

            {
              recentEntries.length > 0 ? (
                <ul>
                  {recentEntries.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="group flex items-center justify-between gap-4 py-3.5 rounded-md hover:bg-surface/45 -mx-2 px-2 transition-colors"
                      >
                        <div class="min-w-0 flex-1 space-y-1">
                          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 font-mono text-[10px] uppercase tracking-[0.14em]">
                            <span class={`font-medium ${JOURNAL_KIND_COLOR[item.kind]}`}>
                              {JOURNAL_KIND_LABEL[item.kind]}
                            </span>
                            <span aria-hidden="true" class="text-ink-muted/60">·</span>
                            <span class="text-ink-muted">{item.dateLabel}</span>
                          </div>

                          <p class="font-serif text-lg font-medium text-ink leading-snug group-hover:text-accent transition-colors">
                            {item.title}
                          </p>
                        </div>

                        {item.thumbnailSrc ? (
                          <div class="w-16 sm:w-20 aspect-[4/3] shrink-0 overflow-hidden rounded-sm bg-surface">
                            <img
                              src={item.thumbnailSrc}
                              alt={item.thumbnailAlt ?? item.title}
                              width="160"
                              height="120"
                              decoding="async"
                              class="editorial-photo h-full w-full object-cover"
                            />
                          </div>
                        ) : (
                          <span
                            aria-hidden="true"
                            class="shrink-0 font-mono text-xs text-ink-muted group-hover:text-accent transition-colors"
                          >
                            →
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="py-6 text-sm text-ink-muted">Nothing here yet.</p>
              )
            }
          </section>
        </div>

        <!-- Right Column (6/12): Two Vertical Stacked Layers -->
        <div class="lg:col-span-6 py-10 lg:py-12 lg:pl-10 flex flex-col gap-0">
          <!-- Layer 1 (Top): Photo Gallery Portal -->
          <figure>
            <a
              href="/photos"
              aria-label={featuredPhoto ? `${featuredPhoto.title} — All photos` : "All photos"}
              class="group block w-full text-start"
            >
              <span class="block overflow-hidden rounded-lg bg-surface">
                {
                  featuredPhoto ? (
                    <img
                      src={featuredPhoto.imageUrl}
                      alt={featuredPhoto.alt}
                      fetchpriority="high"
                      decoding="async"
                      class="editorial-photo aspect-[16/10] w-full object-cover"
                    />
                  ) : (
                    <svg
                      viewBox="0 0 800 500"
                      class="block aspect-[16/10] w-full select-none"
                      role="img"
                      aria-label="35mm viewfinder"
                    >
                      <defs>
                        <pattern id="swiss-viewfinder-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                          <path
                            d="M 40 0 L 0 0 0 40"
                            fill="none"
                            stroke="var(--border)"
                            stroke-width="0.65"
                            opacity="0.7"
                          />
                        </pattern>
                      </defs>

                      <rect width="800" height="500" fill="var(--surface)" />
                      <rect width="800" height="500" fill="url(#swiss-viewfinder-grid)" />

                      {/* Subtle 35mm sprocket edge ticks */}
                      <g fill="var(--border)" opacity="0.55">
                        <rect x="44" y="14" width="22" height="10" />
                        <rect x="124" y="14" width="22" height="10" />
                        <rect x="204" y="14" width="22" height="10" />
                        <rect x="284" y="14" width="22" height="10" />
                        <rect x="364" y="14" width="22" height="10" />
                        <rect x="444" y="14" width="22" height="10" />
                        <rect x="524" y="14" width="22" height="10" />
                        <rect x="604" y="14" width="22" height="10" />
                        <rect x="684" y="14" width="22" height="10" />
                        <rect x="734" y="14" width="22" height="10" />

                        <rect x="44" y="476" width="22" height="10" />
                        <rect x="124" y="476" width="22" height="10" />
                        <rect x="204" y="476" width="22" height="10" />
                        <rect x="284" y="476" width="22" height="10" />
                        <rect x="364" y="476" width="22" height="10" />
                        <rect x="444" y="476" width="22" height="10" />
                        <rect x="524" y="476" width="22" height="10" />
                        <rect x="604" y="476" width="22" height="10" />
                        <rect x="684" y="476" width="22" height="10" />
                        <rect x="734" y="476" width="22" height="10" />
                      </g>

                      {/* Inner 35mm negative matte frame */}
                      <rect
                        x="48"
                        y="46"
                        width="704"
                        height="408"
                        fill="var(--surface-elevated)"
                        fill-opacity="0.55"
                        stroke="var(--border)"
                        stroke-width="1"
                      />

                      {/* Rule-of-thirds hairlines */}
                      <g stroke="var(--border)" stroke-width="0.75" stroke-dasharray="4 6" opacity="0.85">
                        <line x1="282.6" y1="46" x2="282.6" y2="454" />
                        <line x1="517.3" y1="46" x2="517.3" y2="454" />
                        <line x1="48" y1="182" x2="752" y2="182" />
                        <line x1="48" y1="318" x2="752" y2="318" />
                      </g>

                      {/* 35mm Viewfinder Corner Crop Marks */}
                      <g stroke="var(--ink)" stroke-width="1.6" fill="none" opacity="0.75">
                        <path d="M 76 100 L 76 74 L 102 74" />
                        <path d="M 698 74 L 724 74 L 724 100" />
                        <path d="M 76 400 L 76 426 L 102 426" />
                        <path d="M 698 426 L 724 426 L 724 400" />
                      </g>

                      {/* Central Rangefinder Focus Reticle */}
                      <g transform="translate(400, 250)">
                        <circle
                          cx="0"
                          cy="0"
                          r="68"
                          fill="none"
                          stroke="var(--border)"
                          stroke-width="1"
                        />
                        <circle
                          cx="0"
                          cy="0"
                          r="38"
                          fill="none"
                          stroke="var(--accent)"
                          stroke-width="1.15"
                          stroke-dasharray="3 3"
                          opacity="0.85"
                        />
                        <line x1="-88" y1="0" x2="-46" y2="0" stroke="var(--ink-muted)" stroke-width="0.9" />
                        <line x1="46" y1="0" x2="88" y2="0" stroke="var(--ink-muted)" stroke-width="0.9" />
                        <line x1="0" y1="-88" x2="0" y2="-46" stroke="var(--ink-muted)" stroke-width="0.9" />
                        <line x1="0" y1="46" x2="0" y2="88" stroke="var(--ink-muted)" stroke-width="0.9" />
                        <line x1="-10" y1="0" x2="10" y2="0" stroke="var(--accent)" stroke-width="1.2" />
                        <line x1="0" y1="-10" x2="0" y2="10" stroke="var(--accent)" stroke-width="1.2" />
                      </g>
                    </svg>
                  )
                }
              </span>
              <figcaption class="mt-2.5 flex items-center justify-between gap-2 font-mono text-[11px] uppercase tracking-[0.12em]">
                <span class="text-ink-muted">
                  {featuredPhoto ? featuredPhoto.title : "Photos"}
                </span>
                <svg class="size-3.5 stroke-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                  <use href="/ui.svg#arrow-right"></use>
                </svg>
              </figcaption>
            </a>
          </figure>

          <!-- Layer 2 (Bottom): Tactile Bookshelf -->
          <div class="mt-9 pt-6 flex flex-col gap-4" aria-labelledby="hero-bookshelf-heading">
            <div class="flex items-center justify-between gap-4">
              <h2 id="hero-bookshelf-heading" class="editorial-kicker text-accent">
                Bookshelf
              </h2>
              <a
                href="/books"
                aria-label="All books"
                title="All books"
                class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md text-ink-muted hover:text-accent transition-colors"
              >
                <svg class="size-4 stroke-current" aria-hidden="true">
                  <use href="/ui.svg#arrow-right"></use>
                </svg>
              </a>
            </div>

            {
              shelfSpines.length > 0 ? (
                <>
                  <div class="space-y-0">
                    <div class="flex items-end justify-start sm:justify-between gap-2 overflow-x-auto pt-3 pb-0 px-1">
                      {shelfSpines.map((book) => {
                        const palette = SPINE_PALETTES[book.spineTheme]
                        return (
                          <a
                            href={`/books/#book-${book.slug}`}
                            aria-label={`${book.title} by ${book.author}`}
                            class="book-spine-btn shrink-0 flex-1 max-w-[60px] min-w-[42px] flex flex-col items-center justify-between rounded-none border px-1.5 py-3 shadow-sm"
                            style={{
                              "background-color": palette.bg,
                              color: palette.text,
                              "border-color": palette.border,
                              "block-size": "188px",
                            }}
                          >
                            <span
                              aria-hidden="true"
                              class="w-full h-0.5 opacity-80"
                              style={{ "background-color": palette.band }}
                            />
                            <span
                              class="my-2 font-serif text-xs font-medium tracking-tight"
                              style={{
                                "writing-mode": "vertical-rl",
                                "max-block-size": "124px",
                                overflow: "hidden",
                                "text-overflow": "ellipsis",
                              }}
                            >
                              {book.title}
                            </span>
                            <span
                              aria-hidden="true"
                              class="w-full h-0.5 opacity-70"
                              style={{ "background-color": palette.band }}
                            />
                          </a>
                        )
                      })}
                    </div>

                    <div aria-hidden="true" class="space-y-0">
                      <div class="h-2.5 w-full border-t border-accent/40 bg-surface-elevated shadow-[0_8px_16px_-10px_rgba(19,18,16,0.45)]" />
                      <div class="h-1 w-[97%] mx-auto bg-border/60" />
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href="/books"
                  aria-label="Bookshelf"
                  class="group block space-y-4 focus-visible:outline-2"
                >
                  <div class="rounded-lg bg-surface/55 px-4 pt-5 pb-3 transition-colors group-hover:bg-surface/80">
                    <svg
                      viewBox="0 0 560 112"
                      class="block w-full h-auto select-none"
                      role="img"
                      aria-label="Bookshelf"
                    >
                      {/* Subtle vertical index ticks */}
                      <g stroke="var(--border)" stroke-width="0.75" opacity="0.65">
                        <line x1="112" y1="24" x2="112" y2="84" stroke-dasharray="3 4" />
                        <line x1="224" y1="24" x2="224" y2="84" stroke-dasharray="3 4" />
                        <line x1="336" y1="24" x2="336" y2="84" stroke-dasharray="3 4" />
                        <line x1="448" y1="24" x2="448" y2="84" stroke-dasharray="3 4" />
                      </g>

                      {/* Left architectural brass bookend */}
                      <path
                        d="M 28 24 L 36 24 L 36 86 L 74 86 L 74 90 L 28 90 Z"
                        fill="var(--accent)"
                        opacity="0.78"
                      />
                      <rect
                        x="42"
                        y="32"
                        width="18"
                        height="54"
                        fill="none"
                        stroke="var(--border)"
                        stroke-width="1"
                        stroke-dasharray="3 2"
                      />

                      {/* Right architectural brass bookend */}
                      <path
                        d="M 532 24 L 524 24 L 524 86 L 486 86 L 486 90 L 532 90 Z"
                        fill="var(--accent)"
                        opacity="0.78"
                      />
                      <rect
                        x="500"
                        y="38"
                        width="18"
                        height="48"
                        fill="none"
                        stroke="var(--border)"
                        stroke-width="1"
                        stroke-dasharray="3 2"
                      />

                      {/* Horizontal shelf ledge */}
                      <rect
                        x="12"
                        y="90"
                        width="536"
                        height="9"
                        fill="var(--surface-elevated)"
                        stroke="var(--border)"
                        stroke-width="1"
                      />
                      <line
                        x1="12"
                        y1="90"
                        x2="548"
                        y2="90"
                        stroke="var(--accent)"
                        stroke-width="1.2"
                        opacity="0.5"
                      />
                      <rect
                        x="26"
                        y="99"
                        width="508"
                        height="4"
                        fill="var(--border)"
                        opacity="0.7"
                      />
                    </svg>
                  </div>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Section 2: Full-Width Travel Atlas Band -->
  <section class="bg-surface/35" aria-labelledby="home-atlas-heading">
    <Container size="lg">
      <div class="py-12 lg:py-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- Left (8/12): Static Natural Earth 110m World Map (0 KB JS) -->
        <div class="lg:col-span-8">
          <a
            href="/travel"
            aria-label="Explore the full interactive Travel Atlas"
            class="group block relative aspect-[1000/520] w-full overflow-hidden rounded-lg"
          >
            <svg
              viewBox={`0 0 ${WORLD_NE_VIEWBOX.width} ${WORLD_NE_VIEWBOX.height}`}
              class="block h-full w-full"
              role="img"
              aria-label="Natural Earth world map displaying Anuj Gautam's visited countries and travel coordinates"
            >
              <path
                d={worldGraticule.outlinePath}
                fill="var(--surface)"
                stroke="none"
              />

              <g fill="none" stroke="var(--border)" stroke-width="0.6" opacity="0.55">
                {worldGraticule.parallels.map((line) => (
                  <path
                    d={line.d}
                    stroke-dasharray={line.isPrimary ? "4 4" : undefined}
                  />
                ))}
                {worldGraticule.meridians.map((line) => (
                  <path d={line.d} />
                ))}
              </g>

              <g>
                {WORLD_COUNTRIES.map((country) => {
                  const isVisited = visitedCountrySet.has(country.id)
                  return (
                    <path
                      d={country.d}
                      fill={isVisited ? "var(--atlas-soft)" : "var(--surface-elevated)"}
                      fill-opacity={isVisited ? 0.92 : 0.85}
                      stroke={isVisited ? "var(--atlas)" : "var(--border)"}
                      stroke-width={isVisited ? 0.95 : 0.55}
                    />
                  )
                })}
              </g>

              {mapPins.length > 1 && (
                <polyline
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="1.4"
                  stroke-dasharray="4 5"
                  stroke-opacity="0.55"
                  points={mapPins.map((pin) => `${pin.point.x},${pin.point.y}`).join(" ")}
                />
              )}

              {mapPins.map((pin) => (
                <g>
                  <circle cx={pin.point.x} cy={pin.point.y} r="11" fill="var(--accent)" opacity="0.18" />
                  <circle
                    cx={pin.point.x}
                    cy={pin.point.y}
                    r="4.5"
                    fill="var(--accent)"
                    stroke="var(--bg)"
                    stroke-width="1.6"
                  />
                  <text
                    x={pin.point.x + 10}
                    y={pin.point.y - 10}
                    text-anchor="start"
                    fill="var(--ink)"
                    font-family="JetBrains Mono, monospace"
                    font-size="11.5"
                    font-weight="600"
                    letter-spacing="0.4"
                  >
                    {pin.label}
                  </text>
                </g>
              ))}
            </svg>
          </a>
        </div>

        <!-- Right (4/12): Atlas Index & Coordinates -->
        <div class="lg:col-span-4 space-y-5">
          <h2 id="home-atlas-heading" class="font-serif text-3xl sm:text-[2rem] font-medium text-ink leading-tight">
            Travel Atlas
          </h2>

          {
            mapPins.length > 0 ? (
              <ul class="space-y-0.5">
                {mapPins.slice(0, 4).map((pin) => (
                  <li>
                    <a
                      href={pin.href}
                      class="group flex items-baseline justify-between gap-3 py-2 text-sm hover:text-accent transition-colors"
                    >
                      <span class="flex items-baseline gap-2.5 min-w-0">
                        <span class="font-mono text-[11px] font-semibold tracking-wider text-atlas shrink-0">
                          {pin.code}
                        </span>
                        <span class="font-serif text-base text-ink group-hover:text-accent transition-colors truncate">
                          {pin.label}
                        </span>
                      </span>
                      <span class="font-mono text-[11px] text-ink-muted shrink-0">
                        {pin.coordinatesLabel}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="space-y-0.5">
                <li class="flex items-baseline justify-between gap-3 py-2 text-sm">
                  <span class="flex items-baseline gap-2.5 min-w-0">
                    <span class="font-mono text-[11px] font-semibold tracking-wider text-atlas shrink-0">
                      USA
                    </span>
                    <span class="font-serif text-base text-ink truncate">
                      Lower 48 States
                    </span>
                  </span>
                  <span class="font-mono text-xs text-ink-muted shrink-0 tabular-nums">
                    {`${parkSummary.lower48StatesVisited} / ${parkSummary.lower48StatesTotal}`}
                  </span>
                </li>
                <li class="flex items-baseline justify-between gap-3 py-2 text-sm">
                  <span class="flex items-baseline gap-2.5 min-w-0">
                    <span class="font-mono text-[11px] font-semibold tracking-wider text-accent shrink-0">
                      NPS
                    </span>
                    <span class="font-serif text-base text-ink truncate">
                      National Parks
                    </span>
                  </span>
                  <span class="font-mono text-xs text-ink-muted shrink-0 tabular-nums">
                    {`${parkSummary.visitedParks} / ${parkSummary.totalParks}`}
                  </span>
                </li>
              </ul>
            )
          }

          <div class="pt-1">
            <a
              href="/travel"
              aria-label="Open Travel Atlas"
              title="Travel Atlas"
              class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md text-ink-muted hover:text-accent transition-colors"
            >
              <svg class="size-4 stroke-current" aria-hidden="true">
                <use href="/ui.svg#arrow-right"></use>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Section 3: Compact 3-Column Workshop / Selected Projects Strip -->
  <section class="py-14" aria-labelledby="workshop-heading">
    <Container size="lg">
      <div class="flex items-center justify-between gap-4 pb-6">
        <h2 id="workshop-heading" class="editorial-kicker">Projects</h2>
        <a
          href="/projects"
          aria-label="All projects"
          title="All projects"
          class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md text-ink-muted hover:text-accent transition-colors"
        >
          <svg class="size-4 stroke-current" aria-hidden="true">
            <use href="/ui.svg#arrow-right"></use>
          </svg>
        </a>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        {
          projects.slice(0, 3).map((project) => (
            <li class="py-2 flex flex-col justify-between gap-4">
              <div class="space-y-2.5">
                <h3 class="font-serif text-xl sm:text-2xl font-medium text-ink leading-snug">
                  <a
                    href={`/projects/${project.slug}/`}
                    class="hover:text-accent transition-colors"
                  >
                    {project.data.title}
                  </a>
                </h3>

                <p class="text-sm text-ink-muted leading-relaxed line-clamp-2">
                  {project.data.summary}
                </p>
              </div>

              {(project.data.demoUrl || project.data.repoUrl) && (
                <div class="flex flex-wrap items-center gap-2 pt-2">
                  {project.data.demoUrl && (
                    <a
                      href={project.data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${project.data.title} live site`}
                      title="Live site"
                      class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md text-atlas hover:text-accent transition-colors"
                    >
                      <svg class="size-4 fill-current" aria-hidden="true">
                        <use href="/ui.svg#globe"></use>
                      </svg>
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.data.title} on GitHub`}
                      title="GitHub"
                      class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-md text-ink-muted hover:text-accent transition-colors"
                    >
                      <svg class="size-4 fill-current" aria-hidden="true">
                        <use href="/social.svg#github"></use>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </Container>
  </section>
</PageLayout>
