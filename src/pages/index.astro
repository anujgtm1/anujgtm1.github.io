---
import { getCollection, getEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import { SITE, SOCIALS } from "@consts"
import { SPINE_PALETTES, deriveYearRead, sortBooks } from "@lib/bookshelf"
import { formatCoordinates } from "@lib/atlas"
import { formatDate, formatShortDate, readingTime } from "@lib/utils"

const [rawPosts, rawProjects, rawBooks, rawTrips, nowEntry] = await Promise.all([
  getCollection("blog"),
  getCollection("projects"),
  getCollection("books"),
  getCollection("travel"),
  getEntry("now", "current"),
])

const posts = rawPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)

const projects = rawProjects
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const books = sortBooks(
  rawBooks
    .filter((book) => !book.data.draft)
    .map((book) => ({
      slug: book.slug,
      title: book.data.title,
      author: book.data.author,
      status: book.data.status,
      rating: book.data.rating,
      dateRead: book.data.dateRead ? formatShortDate(book.data.dateRead) : undefined,
      yearRead: deriveYearRead(book.data.dateRead, book.data.yearRead),
      pages: book.data.pages,
      isbn: book.data.isbn,
      coverUrl: book.data.coverUrl,
      tags: book.data.tags,
      spineTheme: book.data.spineTheme,
      quote: book.data.quote,
      summary: book.data.summary,
      notesHtml: "",
    })),
)

const currentlyReadingBook = books.find((book) => book.status === "reading") ?? books[0]
const featuredSpines = books.slice(0, 6)

const trips = rawTrips
  .filter((trip) => !trip.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const latestTrip = trips[0]
const previewTrips = trips.slice(0, 4)

const showDayJobCard = !currentlyReadingBook && !latestTrip
const fieldDeskCount =
  (currentlyReadingBook ? 1 : 0) +
  (latestTrip ? 1 : 0) +
  (showDayJobCard ? 1 : 0) +
  2
const fieldDeskGridClass =
  fieldDeskCount >= 4
    ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
    : fieldDeskCount === 3
      ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-2"
---

<PageLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <!-- Editorial Masthead -->
  <section class="pt-12 pb-12 sm:pt-20 sm:pb-16 border-b border-border">
    <Container size="lg">
      <div class="max-w-3xl space-y-6">
        <p class="editorial-kicker">
          Software Engineer · Reader · Traveler
        </p>

        <h1 class="editorial-display text-ink">
          Field notes on resilient systems, good books, and places worth remembering.
        </h1>

        <p class="max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
          I'm <strong class="font-semibold text-ink">Anuj Gautam</strong> — a software engineer working on data center infrastructure deployment at Google, with a PhD in usable security from the University of Tennessee. Outside the day job, I build small opinionated tools, scribble short notes on books, and collect passport stamps.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-md bg-ink px-4 py-2.5 text-sm font-medium text-bg hover:bg-accent transition-colors"
          >
            <span>Read the blog</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/books"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent transition-colors"
          >
            <span>Bookshelf</span>
          </a>
          <a
            href="/travel"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent transition-colors"
          >
            <span>Travel Atlas</span>
          </a>
          <a
            href="/projects"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent transition-colors"
          >
            <span>Projects</span>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Live "Currently / Field Desk" Strip -->
  <section class="py-10 sm:py-12 border-b border-border bg-surface/45" aria-labelledby="field-desk-heading">
    <Container size="lg">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2 id="field-desk-heading" class="editorial-kicker">
          Currently · Field Desk
        </h2>
        <a
          href="/now"
          class="whitespace-nowrap shrink-0 text-xs font-mono uppercase tracking-wider text-ink-muted underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent transition-colors"
        >
          Full /now ledger →
        </a>
      </div>

      <div class={`grid ${fieldDeskGridClass} gap-4`}>
        {showDayJobCard && (
          <a
            href="/work"
            class="editorial-card group rounded-xl border border-border bg-surface-elevated p-5 flex flex-col justify-between gap-3 hover:border-accent"
          >
            <span class="text-xs font-mono uppercase tracking-widest text-atlas">
              Day Job
            </span>
            <div class="space-y-1">
              <p class="font-serif text-lg font-medium text-ink group-hover:text-accent transition-colors">
                Google · Software Engineer
              </p>
              <p class="text-xs text-ink-muted">
                Data center infrastructure deployment software
              </p>
            </div>
          </a>
        )}

        {currentlyReadingBook && (
          <a
            href={`/books/#book-${currentlyReadingBook.slug}`}
            class="editorial-card group rounded-xl border border-border bg-surface-elevated p-5 flex flex-col justify-between gap-3 hover:border-accent"
          >
            <span class="text-xs font-mono uppercase tracking-widest text-accent">
              Currently Reading
            </span>
            <div class="space-y-1">
              <p class="font-serif text-lg font-medium text-ink group-hover:text-accent transition-colors">
                {currentlyReadingBook.title}
              </p>
              <p class="text-xs text-ink-muted">{currentlyReadingBook.author}</p>
            </div>
          </a>
        )}

        {latestTrip && (
          <a
            href={`/travel/${latestTrip.slug}/`}
            class="editorial-card group rounded-xl border border-border bg-surface-elevated p-5 flex flex-col justify-between gap-3 hover:border-accent"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-mono uppercase tracking-widest text-atlas">
                Latest Stamp
              </span>
              <span class="rounded bg-atlas-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-atlas">
                {latestTrip.data.stampCode}
              </span>
            </div>
            <div class="space-y-1">
              <p class="font-serif text-lg font-medium text-ink group-hover:text-accent transition-colors">
                {latestTrip.data.city}, {latestTrip.data.country}
              </p>
              <p class="text-xs font-mono text-ink-muted">
                {formatShortDate(latestTrip.data.date)}
              </p>
            </div>
          </a>
        )}

        <a
          href="/projects"
          class="editorial-card group rounded-xl border border-border bg-surface-elevated p-5 flex flex-col justify-between gap-3 hover:border-accent"
        >
          <span class="text-xs font-mono uppercase tracking-widest text-ink-muted">
            Currently Building
          </span>
          <div class="space-y-1">
            <p class="font-serif text-base font-medium text-ink group-hover:text-accent transition-colors leading-snug">
              {nowEntry?.data.currentlyBuilding ?? "Personal CRM & Bookbinder Studio"}
            </p>
          </div>
        </a>

        <a
          href="/now"
          class="editorial-card group rounded-xl border border-border bg-surface-elevated p-5 flex flex-col justify-between gap-3 hover:border-accent"
        >
          <span class="text-xs font-mono uppercase tracking-widest text-ink-muted">
            Updated {nowEntry ? formatShortDate(nowEntry.data.updatedAt) : "Recently"}
          </span>
          <div class="space-y-1">
            <p class="font-serif text-base font-medium text-ink group-hover:text-accent transition-colors leading-snug">
              {nowEntry?.data.listeningOrThinking ?? "Short, honest notes on books and systems."}
            </p>
          </div>
        </a>
      </div>
    </Container>
  </section>

  <!-- Selected Writing -->
  <section class="py-14 sm:py-16 border-b border-border" aria-labelledby="writing-heading">
    <Container size="lg">
      <div class="flex items-baseline justify-between gap-4 mb-8">
        <div class="space-y-1">
          <p class="editorial-kicker">Dispatches &amp; Notes</p>
          <h2 id="writing-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
            Selected Writing
          </h2>
        </div>
        <a
          href="/blog"
          class="text-sm font-medium text-ink-muted underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent transition-colors"
        >
          All writing →
        </a>
      </div>

      {
        posts.length > 0 ? (
          <ul class="divide-y divide-border border-y border-border">
            {
              posts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="group py-6 flex flex-col md:flex-row md:items-baseline justify-between gap-3 md:gap-8 hover:bg-surface/40 px-2 -mx-2 rounded-lg transition-colors"
                  >
                    <div class="space-y-1.5 max-w-2xl">
                      <h3 class="font-serif text-xl sm:text-2xl font-medium text-ink group-hover:text-accent transition-colors">
                        {post.data.title}
                      </h3>
                      <p class="text-sm text-ink-muted leading-relaxed">
                        {post.data.summary}
                      </p>
                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {post.data.tags.map((tag) => (
                          <span class="rounded border border-border bg-surface px-2 py-0.5 text-[11px] font-mono text-ink-muted">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>
                    <div class="flex md:flex-col md:items-end gap-2 shrink-0 text-xs font-mono text-ink-muted">
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date)}
                      </time>
                      <span>{readingTime(post.body)}</span>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        ) : (
          <div class="rounded-xl border border-dashed border-border bg-surface/55 p-8 sm:p-10 space-y-2">
            <p class="editorial-kicker text-accent">Notes Desk</p>
            <p class="font-serif text-xl sm:text-2xl font-medium text-ink">
              First dispatches on the desk — short notes on books, software, and places coming soon.
            </p>
          </div>
        )
      }
    </Container>
  </section>

  <!-- Engineering Projects (Numbered Dossiers) -->
  <section class="py-14 sm:py-16 border-b border-border" aria-labelledby="projects-heading">
    <Container size="lg">
      <div class="flex items-baseline justify-between gap-4 mb-8">
        <div class="space-y-1">
          <p class="editorial-kicker">Workshop</p>
          <h2 id="projects-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
            Engineering Projects
          </h2>
        </div>
        <a
          href="/projects"
          class="text-sm font-medium text-ink-muted underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent transition-colors"
        >
          All dossiers →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          projects.map((project, idx) => (
            <article class="editorial-card flex flex-col justify-between gap-5 rounded-xl border border-border bg-surface-elevated p-6 hover:border-accent">
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2 text-xs font-mono">
                  <span class="text-ink-muted">0{idx + 1}</span>
                  <span class="rounded bg-atlas-soft px-2 py-0.5 uppercase tracking-wider text-atlas font-medium">
                    {project.data.status}
                  </span>
                </div>

                <h3 class="font-serif text-2xl font-medium text-ink">
                  <a
                    href={`/projects/${project.slug}/`}
                    class="hover:text-accent transition-colors"
                  >
                    {project.data.title}
                  </a>
                </h3>

                <p class="text-sm text-ink-muted leading-relaxed">
                  {project.data.summary}
                </p>

                <div class="flex flex-wrap gap-1.5 pt-1">
                  {project.data.tags.slice(0, 4).map((tag) => (
                    <span class="rounded border border-border bg-surface px-2 py-0.5 text-[11px] font-mono text-ink-muted">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 border-t border-border pt-4 text-xs font-mono">
                <a
                  href={`/projects/${project.slug}/`}
                  class="font-medium text-ink hover:text-accent transition-colors"
                >
                  Read dossier →
                </a>
                {project.data.demoUrl ? (
                  <a
                    href={project.data.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-atlas hover:text-accent transition-colors"
                  >
                    Live ↗
                  </a>
                ) : project.data.repoUrl ? (
                  <a
                    href={project.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-atlas hover:text-accent transition-colors"
                  >
                    GitHub ↗
                  </a>
                ) : null}
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- From the Bookshelf & Atlas -->
  <section class="py-14 sm:py-16 border-b border-border" aria-labelledby="shelf-atlas-heading">
    <Container size="lg">
      <div class="mb-8 space-y-1">
        <p class="editorial-kicker">Interactive Curiosities</p>
        <h2 id="shelf-atlas-heading" class="font-serif text-2xl sm:text-3xl font-medium text-ink">
          From the Bookshelf &amp; Atlas
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Mini Bookshelf Teaser -->
        <div class="rounded-xl border border-border bg-surface-elevated p-6 flex flex-col justify-between gap-6">
          <div class="flex items-baseline justify-between gap-3">
            <div class="space-y-1">
              <h3 class="font-serif text-xl font-medium text-ink">Bookshelf</h3>
              <p class="text-sm text-ink-muted">Quick marginalia &amp; favorites on the desk.</p>
            </div>
            <a
              href="/books"
              class="text-xs font-mono uppercase tracking-wider text-accent hover:underline underline-offset-4 shrink-0"
            >
              {books.length > 0 ? `All ${books.length} →` : "Visit shelf →"}
            </a>
          </div>

          {
            featuredSpines.length > 0 ? (
              <div>
                <div class="flex items-end justify-start gap-2 overflow-x-auto pt-4 pb-0 px-2">
                  {
                    featuredSpines.map((book) => {
                      const palette = SPINE_PALETTES[book.spineTheme]
                      return (
                        <a
                          href={`/books/#book-${book.slug}`}
                          aria-label={`${book.title} by ${book.author}`}
                          class="book-spine-btn shrink-0 flex flex-col items-center justify-between rounded-t border px-1.5 py-2.5"
                          style={{
                            "background-color": palette.bg,
                            color: palette.text,
                            "border-color": palette.border,
                            "min-inline-size": "44px",
                            "min-block-size": "168px",
                          }}
                        >
                          <span
                            aria-hidden="true"
                            class="w-full h-0.5 rounded-full opacity-75"
                            style={{ "background-color": palette.band }}
                          />
                          <span
                            class="my-2 font-serif text-xs font-medium tracking-tight"
                            style={{
                              "writing-mode": "vertical-rl",
                              "max-block-size": "112px",
                              overflow: "hidden",
                              "text-overflow": "ellipsis",
                            }}
                          >
                            {book.title}
                          </span>
                          <span
                            aria-hidden="true"
                            class="w-full h-0.5 rounded-full opacity-70"
                            style={{ "background-color": palette.band }}
                          />
                        </a>
                      )
                    })
                  }
                </div>
                <div aria-hidden="true" class="h-2.5 w-full rounded-sm border-b-4 border-border bg-surface" />
              </div>
            ) : (
              <div class="rounded-lg border border-dashed border-border bg-surface/60 p-5 space-y-2">
                <p class="text-xs font-mono uppercase tracking-widest text-accent">
                  Stocking the Shelf
                </p>
                <p class="font-serif text-base font-medium text-ink">
                  2024–2026 reading covers &amp; quick marginalia on the way.
                </p>
                <p class="text-xs text-ink-muted leading-relaxed">
                  Recent reads, favorites, and short margin notes will appear here as volumes are shelved.
                </p>
              </div>
            )
          }
        </div>

        <!-- Mini Passport Stamps Teaser -->
        <div class="rounded-xl border border-border bg-surface-elevated p-6 flex flex-col justify-between gap-6">
          <div class="flex items-baseline justify-between gap-3">
            <div class="space-y-1">
              <h3 class="font-serif text-xl font-medium text-ink">Travel Atlas</h3>
              <p class="text-sm text-ink-muted">Stamped coordinates &amp; field logs.</p>
            </div>
            <a
              href="/travel"
              class="text-xs font-mono uppercase tracking-wider text-atlas hover:underline underline-offset-4 shrink-0"
            >
              Open map →
            </a>
          </div>

          {
            previewTrips.length > 0 ? (
              <div class="grid grid-cols-2 gap-3">
                {
                  previewTrips.map((trip) => (
                    <a
                      href={`/travel/${trip.slug}/`}
                      class="editorial-card group rounded-lg border border-border bg-surface/65 p-3.5 space-y-1.5 hover:border-accent"
                    >
                      <div class="flex items-center justify-between gap-2">
                        <span class="rounded bg-accent-soft px-2 py-0.5 font-mono text-[11px] font-semibold tracking-wider text-accent">
                          {trip.data.stampCode}
                        </span>
                        <span class="font-mono text-[11px] text-ink-muted">
                          {formatShortDate(trip.data.date)}
                        </span>
                      </div>
                      <p class="font-serif text-base font-medium text-ink group-hover:text-accent transition-colors">
                        {trip.data.city}
                      </p>
                      <p class="font-mono text-[10px] text-ink-muted truncate">
                        {formatCoordinates({ lat: trip.data.lat, lng: trip.data.lng })}
                      </p>
                    </a>
                  ))
                }
              </div>
            ) : (
              <div class="rounded-lg border border-dashed border-border bg-surface/60 p-5 space-y-2">
                <p class="text-xs font-mono uppercase tracking-widest text-atlas">
                  Ready for Stamps
                </p>
                <p class="font-serif text-base font-medium text-ink">
                  Stamped coordinates &amp; trip notes coming soon.
                </p>
                <p class="text-xs text-ink-muted leading-relaxed">
                  The archival world projection is live on the Travel Atlas page, ready for the first field logs.
                </p>
              </div>
            )
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Connect Strip -->
  <section class="py-12 sm:py-14" aria-labelledby="connect-heading">
    <Container size="lg">
      <div class="rounded-xl border border-border bg-surface/70 p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="space-y-1.5 max-w-xl">
          <p class="editorial-kicker">Correspondence</p>
          <h2 id="connect-heading" class="font-serif text-2xl font-medium text-ink">
            Always glad to trade book recommendations, travel tips, or systems notes.
          </h2>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          {
            SOCIALS.map((social) => (
              <a
                href={social.HREF}
                target={social.HREF.startsWith("mailto:") ? undefined : "_blank"}
                rel={social.HREF.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-3.5 py-2 text-sm font-medium text-ink hover:border-accent hover:text-accent transition-colors"
              >
                <svg class="size-4 fill-current" aria-hidden="true">
                  <use href={`/social.svg#${social.ICON}`}></use>
                </svg>
                <span>{social.NAME}</span>
              </a>
            ))
          }
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-3.5 py-2 text-sm font-medium text-ink hover:border-accent hover:text-accent transition-colors"
          >
            <svg class="size-4 stroke-current" aria-hidden="true">
              <use href="/ui.svg#rss"></use>
            </svg>
            <span>RSS</span>
          </a>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
