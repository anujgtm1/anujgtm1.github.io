---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import PhotoAlbums from "@components/PhotoAlbums"
import { PHOTOS } from "@consts"
import { buildPhotoAlbums, sortPhotos } from "@lib/photos"
import { formatShortDate } from "@lib/utils"
import type { PhotoItem } from "@types"

const rawPhotos = (await getCollection("photos")).filter((entry) => !entry.data.draft)

const photos: readonly PhotoItem[] = sortPhotos(
  rawPhotos.map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    imageUrl: entry.data.imageUrl,
    thumbnailUrl: entry.data.thumbnailUrl,
    alt: entry.data.alt,
    caption: entry.data.caption,
    date: formatShortDate(entry.data.date),
    dateIso: entry.data.date.toISOString(),
    dateMs: entry.data.date.getTime(),
    location: entry.data.location,
    album: entry.data.album,
    category: entry.data.category,
    camera: entry.data.camera,
    aspectRatio: entry.data.aspectRatio,
    featured: entry.data.featured,
    tags: entry.data.tags,
    linkedHref: entry.data.linkedHref,
    linkedLabel: entry.data.linkedLabel,
    draft: entry.data.draft,
  })),
)

const albums = buildPhotoAlbums(photos)
---

<PageLayout title={PHOTOS.TITLE} description={PHOTOS.DESCRIPTION}>
  <TopLayout>
    <div class="space-y-3 border-b border-border pb-8">
      <p class="editorial-kicker">
        {
          photos.length > 0
            ? `Through the Lens · ${albums.length} ${albums.length === 1 ? "Album" : "Albums"} · ${photos.length} ${photos.length === 1 ? "Frame" : "Frames"}`
            : "Through the Lens · Photo Archive"
        }
      </p>
      <h1 class="editorial-title text-ink">{PHOTOS.TITLE}</h1>
      <p class="max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
        {PHOTOS.DESCRIPTION}
        {
          photos.length > 0
            ? " Open an album to browse its contact sheet and full-resolution lightbox."
            : ""
        }
      </p>
    </div>
  </TopLayout>

  <BottomLayout>
    <PhotoAlbums client:load albums={albums} photos={photos} />
  </BottomLayout>
</PageLayout>
