---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import TravelAtlas from "@components/TravelAtlas"
import NationalParksAtlas from "@components/NationalParksAtlas"
import { TRAVEL } from "@consts"
import { formatShortDate } from "@lib/utils"
import type { TravelItem } from "@types"

const rawTrips = (await getCollection("travel"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const trips: readonly TravelItem[] = rawTrips.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  city: entry.data.city,
  country: entry.data.country,
  region: entry.data.region,
  stampCode: entry.data.stampCode,
  date: formatShortDate(entry.data.date),
  coordinates: {
    lat: entry.data.lat,
    lng: entry.data.lng,
  },
  summary: entry.data.summary,
  highlights: entry.data.highlights,
}))
---

<PageLayout title={TRAVEL.TITLE} description={TRAVEL.DESCRIPTION}>
  <TopLayout>
    <div class="space-y-3 border-b border-border pb-8">
      <p class="editorial-kicker">
        {trips.length > 0 ? `Field Atlas · ${trips.length} Passport Stamps` : "Field Atlas · Ready for Stamps"}
      </p>
      <h1 class="editorial-title text-ink">{TRAVEL.TITLE}</h1>
      <p class="max-w-2xl text-base sm:text-lg text-ink-muted leading-relaxed">
        {TRAVEL.DESCRIPTION}{trips.length > 0 ? " Select any pin on the projection or browse the stamps below to read trip logs." : ""}
      </p>
    </div>
  </TopLayout>

  <BottomLayout>
    <div class="space-y-14">
      <NationalParksAtlas client:load />

      <div class="space-y-4 border-t border-border pt-12">
        <div class="space-y-1">
          <p class="editorial-kicker">International &amp; Field Logs</p>
          <h2 class="font-serif text-2xl sm:text-3xl font-medium text-ink">
            World Passport Stamps
          </h2>
        </div>
        <TravelAtlas client:load trips={trips} />
      </div>

      <aside
        aria-label="Companion project"
        class="rounded-xl border border-border bg-surface/75 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
      >
        <div class="space-y-1">
          <p class="editorial-kicker">Companion Trip Tool</p>
          <p class="font-serif text-lg text-ink">
            Planning a group route of your own?
          </p>
          <p class="text-sm text-ink-muted">
            Built my own map-first workspace for multi-stop routes, shared bookings, and travel expenses.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <a
            href="https://travel.anujgtm.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md bg-ink px-4 py-2 text-sm font-medium text-bg hover:bg-accent transition-colors"
          >
            <span>Open travel.anujgtm.com</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/projects/travel-planner/"
            class="inline-flex items-center rounded-md border border-border bg-surface-elevated px-3.5 py-2 text-sm font-medium text-ink-muted hover:border-accent hover:text-ink transition-colors"
          >
            Project dossier
          </a>
        </div>
      </aside>
    </div>
  </BottomLayout>
</PageLayout>
