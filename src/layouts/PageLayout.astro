---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import ReadingProgress from "@components/ReadingProgress.astro"
import { SITE } from "@consts"

interface Props {
  title: string
  description: string
  showReadingProgress?: boolean
}

const { title, description, showReadingProgress = false } = Astro.props
const fullTitle = title === SITE.TITLE ? SITE.TITLE : `${title} | ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    {showReadingProgress && <ReadingProgress />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
