---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"travel">
}

const { entry } = Astro.props
const { collection } = entry
const { Content } = await entry.render()

const items = (await getCollection(collection))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const index = items.findIndex((item) => item.slug === entry.slug)
const prev = items.length > 1 ? items[(index - 1 + items.length) % items.length] : null
const next = items.length > 1 ? items[(index + 1) % items.length] : null
---

<div class="space-y-12">
  <article class="pt-4">
    <Content />
  </article>

  {prev && next && (
    <nav aria-label="Related entries" class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-border pt-8">
      <a
        href={`/${prev.collection}/${prev.slug}/`}
        class="editorial-card group flex flex-col justify-between gap-2 rounded-lg border border-border bg-surface-elevated p-5 hover:border-accent"
      >
        <span class="text-xs font-mono uppercase tracking-wider text-ink-muted">
          ← Previous
        </span>
        <span class="font-serif text-lg font-medium text-ink group-hover:text-accent transition-colors">
          {prev.data.title}
        </span>
      </a>
      <a
        href={`/${next.collection}/${next.slug}/`}
        class="editorial-card group flex flex-col justify-between gap-2 rounded-lg border border-border bg-surface-elevated p-5 text-start sm:text-end hover:border-accent"
      >
        <span class="text-xs font-mono uppercase tracking-wider text-ink-muted">
          Next →
        </span>
        <span class="font-serif text-lg font-medium text-ink group-hover:text-accent transition-colors">
          {next.data.title}
        </span>
      </a>
    </nav>
  )}
</div>
