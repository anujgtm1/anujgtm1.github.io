---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"
import { formatCoordinates } from "@lib/atlas"

type Props = {
  entry:
    | CollectionEntry<"projects">
    | CollectionEntry<"blog">
    | CollectionEntry<"travel">
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary, date } = data

const backLabels: Readonly<Record<Props["entry"]["collection"], string>> = {
  blog: "Back to all essays",
  projects: "Back to all projects",
  travel: "Back to travel atlas",
}

const demoUrl = collection === "projects" ? data.demoUrl : null
const repoUrl = collection === "projects" ? data.repoUrl : null
const projectRole = collection === "projects" ? data.role : null
const tags = collection === "travel" ? data.highlights : data.tags
const heroMedia =
  collection === "blog" && data.heroImage
    ? { src: data.heroImage, alt: data.heroImageAlt ?? title }
    : collection === "travel" && data.coverImage
      ? { src: data.coverImage, alt: data.coverImageAlt ?? title }
      : null
const travelMeta =
  collection === "travel"
    ? {
        city: data.city,
        country: data.country,
        region: data.region,
        stampCode: data.stampCode,
        coords: formatCoordinates({ lat: data.lat, lng: data.lng }),
      }
    : null
---

<header class="space-y-6 pb-8">
  <a
    href={`/${collection}`}
    aria-label={backLabels[collection]}
    title={backLabels[collection]}
    class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-surface/80 p-2 text-ink-muted hover:bg-surface hover:text-ink transition-colors"
  >
    <svg class="size-4 stroke-current rotate-180" aria-hidden="true">
      <use href="/ui.svg#arrow-right"></use>
    </svg>
  </a>

  <div class="space-y-4">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono uppercase tracking-wider text-ink-muted">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(body)}</span>
      {travelMeta && (
        <>
          <span aria-hidden="true">·</span>
          <span class="rounded bg-accent-soft px-2 py-0.5 text-accent font-medium">
            {travelMeta.stampCode} · {travelMeta.city}, {travelMeta.country}
          </span>
          <span aria-hidden="true">·</span>
          <span>{travelMeta.coords}</span>
        </>
      )}
    </div>

    <h1 class="editorial-title text-ink">
      {title}
    </h1>

    <p class="max-w-2xl text-lg text-ink-muted leading-relaxed">
      {summary}
    </p>

    {projectRole && (
      <p class="text-sm font-mono text-ink-muted">
        {projectRole}
      </p>
    )}
  </div>

  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" aria-label="Topics">
      {tags.map((tag) => (
        <li class="rounded-full bg-surface px-3 py-1 text-xs font-mono text-ink-muted">
          {tag}
        </li>
      ))}
    </ul>
  )}

  {(demoUrl || repoUrl) && (
    <div class="flex flex-wrap gap-3 pt-1">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${title} live site`}
          class="inline-flex items-center gap-2 rounded-md bg-ink px-4 py-2 text-sm font-medium text-bg hover:bg-accent transition-colors"
        >
          <svg class="size-4 fill-current" aria-hidden="true">
            <use href="/ui.svg#globe"></use>
          </svg>
          <span>Live</span>
        </a>
      )}
      {repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} on GitHub`}
          class="inline-flex items-center gap-2 rounded-md bg-surface px-4 py-2 text-sm font-medium text-ink hover:bg-surface-elevated hover:text-accent transition-colors"
        >
          <svg class="size-4 fill-current" aria-hidden="true">
            <use href="/social.svg#github"></use>
          </svg>
          <span>GitHub</span>
        </a>
      )}
    </div>
  )}

  {heroMedia && (
    <figure class="pt-2">
      <div class="overflow-hidden rounded-lg bg-surface">
        <img
          src={heroMedia.src}
          alt={heroMedia.alt}
          fetchpriority="high"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </div>
    </figure>
  )}
</header>
