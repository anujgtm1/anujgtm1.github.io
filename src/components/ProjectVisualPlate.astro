        <g stroke="var(--ink-muted)" stroke-width="0.9" opacity="0.6">
          <line x1="28" y1="32" x2="40" y2="32" />
          <line x1="34" y1="26" x2="34" y2="38" />
          <line x1="760" y1="32" x2="772" y2="32" />
          <line x1="766" y1="26" x2="766" y2="38" />
          <line x1="28" y1="424" x2="40" y2="424" />
