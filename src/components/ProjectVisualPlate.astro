---
interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props

const safeId = slug.replace(/[^a-z0-9-]/gi, "").toLowerCase() || "plate"
const initials = title
  .split(/\s+/)
  .filter((word) => word.length > 0)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? "")
  .join("") || "AG"
---

<div class="editorial-plate relative aspect-[16/10] w-full overflow-hidden rounded-lg bg-surface">
  {
    slug === "bookbinder-studio" ? (
      <svg
        viewBox="0 0 800 500"
        class="block h-full w-full select-none"
        role="img"
        aria-label={`${title} — 1:1 hardcover case flat-pattern CAD blueprint`}
      >
        <defs>
          <pattern id={`cad-minor-${safeId}`} width="16" height="16" patternUnits="userSpaceOnUse">
            <path
              d="M 16 0 L 0 0 0 16"
              fill="none"
              stroke="var(--border)"
              stroke-width="0.5"
              opacity="0.5"
            />
          </pattern>
          <pattern id={`cad-major-${safeId}`} width="80" height="80" patternUnits="userSpaceOnUse">
            <rect width="80" height="80" fill={`url(#cad-minor-${safeId})`} />
            <path
              d="M 80 0 L 0 0 0 80"
              fill="none"
              stroke="var(--border)"
              stroke-width="0.9"
              opacity="0.85"
            />
          </pattern>
          <pattern
            id={`hinge-hatch-${safeId}`}
            width="6"
            height="6"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
