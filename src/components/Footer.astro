---
import { SITE, SOCIALS } from "@consts"
import Container from "@components/Container.astro"
---

<footer class="mt-20 bg-surface/60">
  <Container size="lg">
    <div class="py-10 flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2.5 text-ink hover:text-accent transition-colors"
          >
            <svg class="size-7 text-accent" aria-hidden="true">
              <use href="/brand.svg#brand"></use>
            </svg>
            <span class="font-serif text-lg font-medium">{SITE.TITLE}</span>
          </a>
        </div>

        <button
          id="back-to-top"
          type="button"
          aria-label="Back to top"
          title="Back to top"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-surface-elevated/80 p-2 text-sm font-mono text-ink-muted hover:bg-surface-elevated hover:text-ink transition-colors"
        >
          <span aria-hidden="true">↑</span>
        </button>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm text-ink-muted">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono">
          <span>&copy; 2026 {SITE.AUTHOR}</span>
          <span aria-hidden="true">·</span>
          <a href="/about" class="underline decoration-border underline-offset-4 hover:text-ink hover:decoration-accent transition-colors">
            About
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/rss.xml"
            aria-label="RSS"
            title="RSS"
            class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-surface-elevated/80 p-2 text-ink-muted hover:bg-surface-elevated hover:text-ink transition-colors"
          >
            <svg class="size-4 stroke-current" aria-hidden="true">
              <use href="/ui.svg#rss"></use>
            </svg>
          </a>
          {
            SOCIALS.map((social) => (
              <a
                href={social.HREF}
                target={social.HREF.startsWith("mailto:") ? undefined : "_blank"}
                rel={social.HREF.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                aria-label={`${social.NAME} (${SITE.AUTHOR})`}
                title={social.NAME}
                class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-surface-elevated/80 p-2 text-ink-muted hover:bg-surface-elevated hover:text-ink transition-colors"
              >
                <svg class="size-3.5 fill-current" aria-hidden="true">
                  <use href={`/social.svg#${social.ICON}`}></use>
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</footer>

<script is:inline>
  (() => {
    const button = document.getElementById("back-to-top")
    button?.addEventListener("click", () => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      window.scrollTo({
        top: 0,
        behavior: reduced ? "auto" : "smooth",
      })
    })
  })()
</script>
