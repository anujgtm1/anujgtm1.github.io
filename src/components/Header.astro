---
import { SITE, LINKS } from "@consts"
import Container from "@components/Container.astro"

const { pathname } = Astro.url
const firstSegment = pathname.split("/").filter(Boolean)[0]

function isCurrentPath(href: string): boolean {
  if (href === "/") {
    return pathname === "/"
  }
  return pathname === href || `/${firstSegment}` === href
}
---

<header id="site-header" class="site-header">
  <Container size="lg">
    <div id="header-inner" class="header-inner">
      <a
        href="/"
        class="inline-flex items-center gap-2.5 text-ink hover:text-accent transition-colors"
      >
        <svg class="size-8 shrink-0 text-accent" aria-hidden="true">
          <use href="/brand.svg#brand"></use>
        </svg>
        <span class="font-serif text-lg font-medium tracking-tight whitespace-nowrap">
          {SITE.TITLE}
        </span>
      </a>

      <nav class="site-nav" aria-label="Primary">
        <button
          id="menu-button"
          class="menu-button inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-transparent p-2 text-ink hover:bg-surface hover:text-accent transition-colors"
          type="button"
          popovertarget="site-menu"
          popovertargetaction="toggle"
          aria-controls="site-menu"
          aria-label="Menu"
        >
          <svg class="size-4 stroke-current" aria-hidden="true">
            <use href="/ui.svg#menu"></use>
          </svg>
        </button>

        <ul id="site-menu" class="site-menu" popover="auto">
          {
            LINKS.map((link) => {
              const active = isCurrentPath(link.HREF)
              return (
                <li>
                  <a
                    href={link.HREF}
                    aria-current={active ? "page" : undefined}
                    class="nav-link w-full md:w-auto whitespace-nowrap"
                  >
                    {link.TEXT}
                  </a>
                </li>
              )
            })
          }
        </ul>
      </nav>

      <div class="flex items-center gap-1.5">
        <a
          href="/search"
          aria-label={`Search ${SITE.TITLE}`}
          aria-current={isCurrentPath("/search") ? "page" : undefined}
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-transparent p-2 text-ink-muted hover:bg-surface hover:text-ink transition-colors"
        >
          <svg class="size-4 stroke-current" aria-hidden="true">
            <use href="/ui.svg#search"></use>
          </svg>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="inline-flex min-h-9 min-w-9 items-center justify-center rounded-md bg-transparent p-2 text-ink-muted hover:bg-surface hover:text-ink transition-colors"
        >
          <span class="theme-toggle-to-dark">
            <svg class="size-4 stroke-current" aria-hidden="true">
              <use href="/ui.svg#moon"></use>
            </svg>
            <span class="sr-only">Switch to dark theme</span>
          </span>
          <span class="theme-toggle-to-light">
            <svg class="size-4 stroke-current" aria-hidden="true">
              <use href="/ui.svg#sun"></use>
            </svg>
            <span class="sr-only">Switch to light theme</span>
          </span>
        </button>
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (() => {
    const STORAGE_KEY = "color-scheme"
    const mql = window.matchMedia("(prefers-color-scheme: dark)")

    function readStoredScheme() {
      try {
        const value = localStorage.getItem(STORAGE_KEY)
        if (value === "light" || value === "dark") {
          return value
        }
      } catch {
        // Storage unavailable
      }
      return null
    }

    function applyScheme(stored) {
      const meta = document.querySelector('meta[name="color-scheme"]')
      if (meta) {
        meta.setAttribute("content", stored ?? "light dark")
      }
      const renderedDark = stored === "dark" || (stored === null && mql.matches)
      document.documentElement.classList.toggle("dark", renderedDark)
    }

    function toggleTheme() {
      const stored = readStoredScheme()
      const systemScheme = mql.matches ? "dark" : "light"
      const renderedScheme = stored ?? systemScheme
      const targetScheme = renderedScheme === "dark" ? "light" : "dark"

      let nextStored = null
      if (targetScheme !== systemScheme) {
        nextStored = targetScheme
        try {
          localStorage.setItem(STORAGE_KEY, targetScheme)
        } catch {
          // Apply even when persistence is unavailable
        }
      } else {
        try {
          localStorage.removeItem(STORAGE_KEY)
        } catch {
          // Ignore storage errors
        }
      }

      applyScheme(nextStored)
    }

    const themeButton = document.getElementById("theme-toggle")
    themeButton?.addEventListener("click", toggleTheme)

    window.addEventListener("storage", (event) => {
      if (event.key === STORAGE_KEY) {
        applyScheme(readStoredScheme())
      }
    })

    mql.addEventListener("change", () => {
      // Keep Tailwind .dark compatibility synced when following system; NEVER clear a stored override
      applyScheme(readStoredScheme())
    })

    // Responsive single-nav measurement (modern-web-guidance navbar pattern)
    const header = document.getElementById("site-header")
    const inner = document.getElementById("header-inner")
    const menu = document.getElementById("site-menu")
    const menuButton = document.getElementById("menu-button")

    if (header && inner && menu) {
      const supportsPopover = Object.hasOwn(HTMLElement.prototype, "popover")
      let lastCollapsedWidth = 0

      if (!supportsPopover && menuButton) {
        menuButton.addEventListener("click", () => {
          menu.classList.toggle(":popover-open")
        })
      }

      function syncNavLayout(forceMeasure) {
        const currentWidth = header.clientWidth
        const isCurrentlyWide = header.classList.contains("is-wide")
        if (!forceMeasure && !isCurrentlyWide && currentWidth <= lastCollapsedWidth) {
          return
        }

        const wasPopoverOpen =
          !isCurrentlyWide &&
          (supportsPopover ? menu.matches(":popover-open") : menu.classList.contains(":popover-open"))

        header.classList.add("is-measuring")
        menu.removeAttribute("popover")
        header.classList.add("is-wide")

        const fitsInline = inner.scrollWidth <= inner.clientWidth + 1

        if (fitsInline) {
          header.classList.add("is-wide")
          menu.removeAttribute("popover")
          menu.classList.remove(":popover-open")
        } else {
          header.classList.remove("is-wide")
          menu.setAttribute("popover", "auto")
          lastCollapsedWidth = currentWidth
          if (wasPopoverOpen) {
            if (supportsPopover && typeof menu.showPopover === "function") {
              try {
                menu.showPopover()
              } catch {
                // Ignore if already open
              }
            } else {
              menu.classList.add(":popover-open")
            }
          }
        }

        requestAnimationFrame(() => {
          header.classList.remove("is-measuring")
        })
      }

      syncNavLayout(true)

      if (typeof ResizeObserver !== "undefined") {
        const observer = new ResizeObserver(() => syncNavLayout(false))
        observer.observe(header)
        observer.observe(menu)
      }
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => syncNavLayout(true))
      }
    }
  })()
</script>
